# =============================================================================
# GrokSniper AI — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_DB=groksniper
POSTGRES_USER=groksniper_user
POSTGRES_PASSWORD=change_me_strong_password

# Full connection URL used by the Python backend (SQLAlchemy / asyncpg)
DATABASE_URL=postgresql+asyncpg://groksniper_user:change_me_strong_password@localhost:5432/groksniper

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@localhost:6379/0

# -----------------------------------------------------------------------------
# Binance API (spot / futures)
# -----------------------------------------------------------------------------
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
# Set to True to use Binance Testnet instead of live trading
BINANCE_TESTNET=True
ROOT_DOMAIN=localhost:3000

# -----------------------------------------------------------------------------
# Bybit API
# -----------------------------------------------------------------------------
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
# Set to True to use Bybit Testnet instead of live trading
BYBIT_TESTNET=True

# -----------------------------------------------------------------------------
# Grok (xAI) API
# Used by the news-analysis / sentiment module
# -----------------------------------------------------------------------------
GROK_API_KEY=your_grok_api_key_here
GROK_API_BASE_URL=https://api.x.ai/v1

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Environment: development | staging | production
APP_ENV=development
LOG_LEVEL=INFO
# Paper Trading mode — set to False only when ready for real money
PAPER_TRADE=True

# -----------------------------------------------------------------------------
# Telegram Notifications
# Create a bot via @BotFather, then get your chat ID via @userinfobot
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# -----------------------------------------------------------------------------
# Anthropic API (Claude — used by CrewAI Fundamental Analyst Agent)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=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
