# =============================================================================
# GrokSniper AI — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_DB=groksniper
POSTGRES_USER=groksniper_user
POSTGRES_PASSWORD=change_me_strong_password

# Full connection URL used by the Python backend (SQLAlchemy / asyncpg)
DATABASE_URL=postgresql+asyncpg://groksniper_user:change_me_strong_password@localhost:5432/groksniper

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@localhost:6379/0

# -----------------------------------------------------------------------------
# Binance API (spot / futures)
# -----------------------------------------------------------------------------
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
# Set to True to use Binance Testnet instead of live trading
BINANCE_TESTNET=True
ROOT_DOMAIN=localhost:3000

# -----------------------------------------------------------------------------
# Bybit API
# -----------------------------------------------------------------------------
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
# Set to True to use Bybit Testnet instead of live trading
BYBIT_TESTNET=True

# -----------------------------------------------------------------------------
# Grok (xAI) API
# Used by the news-analysis / sentiment module
# -----------------------------------------------------------------------------
GROK_API_KEY=your_grok_api_key_here
GROK_API_BASE_URL=https://api.x.ai/v1

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Environment: development | staging | production
APP_ENV=development
LOG_LEVEL=INFO
# Paper Trading mode — set to False only when ready for real money
PAPER_TRADE=True

# Comma-separated list of tickers to monitor
WATCHLIST=BTC,ETH,SOL,DOGE,XRP

# Scan interval in seconds (default 900 = 15 minutes)
SCAN_INTERVAL=900

# Dry-run mode — no real orders are placed
DRY_RUN=True

# Starting virtual balance for paper trading
INITIAL_EQUITY=1000

# -----------------------------------------------------------------------------
# Telegram Notifications
# Create a bot via @BotFather, then get your chat ID via @userinfobot
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# -----------------------------------------------------------------------------
# Groq API (llama-3.3-70b-versatile — used by all CrewAI Agents)
# Get your free key at: https://console.groq.com  →  API Keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# FinBERT (Local — NO key required)
# Model weights (~400 MB) download automatically from HuggingFace Hub on first run
# and are cached at: ~/.cache/huggingface/hub/
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Anthropic (Claude) — used by AI Trading Agents
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# Security: Only this Telegram user ID can interact with the AI assistant.
# Find yours by messaging @userinfobot on Telegram.
ALLOWED_TELEGRAM_ID=your_telegram_user_id_here
